    <Folder Include="Language\Base\Implementations\Flexible\Concretely\InternalNodes\Contains\" />
    <Folder Include="Language\Base\Implementations\Flexible\Concretely\InternalNodes\Count\" />
    <Folder Include="Language\Base\Implementations\Flexible\Concretely\InternalNodes\Prepending\" />
    <Folder Include="Language\Base\Implementations\Flexible\Loose\Leaf\" />
    <Folder Include="Language\Base\Implementations\Flexible\Loose\Root\" />
    <Folder Include="Language\DooC\" />
    <Folder Include="Language\ModuleMaps\" />
    <Folder Include="Language\ObjectiveCPP\" />
    <Folder Include="Language\ObjectiveC\" />
    <Folder Include="Language\Swift\" />
    <Folder Include="Language\Swift\Parser\Tree\Base\Implementations\LeafNode\" />
    <Folder Include="Language\Swift\Parser\Tree\Base\Implementations\Root\" />
